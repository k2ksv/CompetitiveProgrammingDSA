{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "debug build and run",
      "type": "shell",
      "command": "g++ -std=c++17 -O2 -Wall -Wextra -D_GLIBCXX_DEBUG \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\" && \"${fileDirname}\\${fileBasenameNoExtension}.exe\"",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}